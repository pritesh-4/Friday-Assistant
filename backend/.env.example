APP_NAME=FRIDAY API
APP_ENV=development
DEBUG=False

HOST=127.0.0.1
PORT=8000

FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./friday.db
UPLOADS_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# API Keys (Provide values locally as needed)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Voice & Text-to-Speech Features
VOICE_ENABLED=true
FRIDAY_TTS_PROVIDER=openrouter
FRIDAY_TTS_MODEL=fish-audio/s2.1-pro-free:free
FRIDAY_TTS_VOICE=alloy
FRIDAY_TTS_FORMAT=mp3

# Reserved for future local authentication support. Generate a random value
# before enabling authentication.
SECRET_KEY=

